################################################################################
# Dominion meshes and textures adapted for CP26 from Star Trek: New Horizons.
# Imported with the project owner's permission; gameplay definitions are CP26.
################################################################################

entity = {
	name = "cp26_dominion_attack_ship_entity"
	pdxmesh = "dominion_01_corvette_coreA_mesh"
	locator = { name = "part1" position = { 0 0 0 } }
	locator = { name = "root" rotation = { 0 0 0 } }
	# Imported Stellaris meshes contain weapon locators but no engine locators.
	# Infinite uses these two names to generate the empire-coloured ship trail.
	locator = { name = "engine_small_01" position = { 0.75 0.0 2.4 } }
	locator = { name = "engine_small_02" position = { -0.75 0.0 2.4 } }
	scale = 0.36
	game_data = {
		trail_width = 0.55
		size = 4
	}
}

